[alias]
	s = status
	a = add
	c = commit
	co = checkout
	p = push
	l = log --oneline --graph
	aa = add -A
	ca = commit --amend
	rs = restore --staged

[user]
	name = Yulong Ming
	email = i@myl7.org

[init]
	defaultBranch = main

[pull]
	rebase = true

[core]
	autocrlf = false

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
